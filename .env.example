# Copy to .env and edit. Real environment variables override this file.

# --- Agent identity ---
# The seed decides the agent address. Use the seed of your existing Agentverse agent to keep its address.
AGENT_NAME=docintel-agent
AGENT_SEED=change-me-to-a-long-secret-phrase
AGENT_PORT=8002
# false = local endpoint (local testing); true = receive messages through the Agentverse mailbox
AGENT_MAILBOX=false

# --- MinerU ---
MINERU_API_URL=http://localhost:8000
MINERU_BACKEND=pipeline
MINERU_LANG_LIST=en
MINERU_TIMEOUT_SECONDS=600
# If MinerU is unreachable, reuse saved Markdown for the PDFs in samples/ (byte-identical files only)
MINERU_OFFLINE_FALLBACK=true

# --- Optional Gemini gap-filling (rules run first; the LLM only fills fields they missed) ---
# GEMINI_API_KEY=
# GEMINI_API_KEY1=
# GEMINI_MODEL=gemini-flash-latest

# --- Validation ---
REVIEW_CONFIDENCE_THRESHOLD=0.80
MAX_DOWNLOAD_MB=25
