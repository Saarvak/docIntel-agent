# Copy to .env and edit. Real environment variables override this file.

# --- Agent identity ---
# The seed decides the agent address. Use the seed of your existing Agentverse agent to keep its address.
AGENT_NAME=docintel-agent
AGENT_SEED=change-me-to-a-long-secret-phrase
AGENT_PORT=8002

# --- MinerU cloud API (nothing runs on this machine) ---
# Token: https://mineru.net/apiManage/token
# With a token the agent uses the precise v4 API. Without one it uses the public agent API (smaller files).
MINERU_API_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_BACKEND=pipeline
MINERU_LANG_LIST=en
# MINERU_OCR=true
MINERU_TIMEOUT_SECONDS=600

# --- Optional Gemini gap-filling (rules run first; the LLM only fills fields they missed) ---
# GEMINI_API_KEY=
# GEMINI_API_KEY1=
# GEMINI_MODEL=gemini-flash-latest

# --- Validation ---
REVIEW_CONFIDENCE_THRESHOLD=0.80
MAX_DOWNLOAD_MB=25
